{
    "mise.configureExtensionsIncludeGlobalTools": false,
    "terminal.integrated.suggest.enabled": false,
    "files.watcherExclude": {
        "**/.bloop/**": true,
        "**/.metals/**/*.{java,scala}": true
    },
    "terminal.integrated.initialHint": false,
    "terminal.integrated.scrollback": 100000,
    "security.promptForLocalFileProtocolHandling": false,
    "chat.agentHost.devContainer.enabled": true,
    "dev.containers.defaultExtensions": [
        "ms-vscode.live-server",
        "fuadpashayev.bottom-terminal",
        "l-igh-t.vscode-theme-seti-folder"
    ],
    "dotfiles.repository": "jorgeazevedo/dotfiles",
    "extensions.ignoreRecommendations": true,
    "git.addAICoAuthor": "chatAndAgent",
    "editor.minimap.enabled": false,
    "editor.inlineSuggest.enabled": false,
    "jestrunner.runOptions": [
        ""
    ],
    "jestrunner.jestCommand": "node --experimental-vm-modules 'node_modules/.bin/jest'",
    "jestrunner.debugOptions": {
        "runtimeArgs": [
            "--experimental-vm-modules"
        ]
    },
    "workbench.iconTheme": "vs-seti-folder",
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "acceptEdits",
    "claudeCode.hideOnboarding": true,
    "chat.viewSessions.orientation": "stacked",
    "chat.plugins.marketplaces": [
        "github/awesome-copilot#marketplace",
        "guardian/agent-skills"
    ]
}
